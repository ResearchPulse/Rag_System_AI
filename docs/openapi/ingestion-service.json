{
  "openapi": "3.1.0",
  "info": {
    "title": "Ingestion Service - Rag_System_AI",
    "description": "Microservice for document ingestion, parsing (PDF, DOCX, TXT), text chunking, and metadata management.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Returns the operational status of the Ingestion Service.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "post": {
        "tags": [
          "Documents Ingestion"
        ],
        "summary": "Upload and chunk document",
        "description": "Accepts document metadata and body text, partitions the document into chunks, and returns chunk details.",
        "operationId": "upload_document_api_v1_documents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Document successfully uploaded and chunked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid document payload"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{document_id}": {
      "get": {
        "tags": [
          "Documents Ingestion"
        ],
        "summary": "Get document details by ID",
        "description": "Retrieves metadata, processing status, and text chunks of a specific ingested document.",
        "operationId": "get_document_api_v1_documents__document_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique document ID",
              "examples": [
                "doc_123456789"
              ],
              "title": "Document Id"
            },
            "description": "Unique document ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Document details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Unique identifier for the chunk",
            "examples": [
              "chk_987654321"
            ]
          },
          "chunk_index": {
            "type": "integer",
            "title": "Chunk Index",
            "description": "Sequential index of the chunk within the document",
            "examples": [
              0
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Textual content of the chunk",
            "examples": [
              "This is the first segment of text."
            ]
          },
          "character_count": {
            "type": "integer",
            "title": "Character Count",
            "description": "Total characters in this chunk",
            "examples": [
              37
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Custom metadata associated with this chunk"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "chunk_index",
          "content",
          "character_count"
        ],
        "title": "DocumentChunk",
        "description": "Schema representing an individual text chunk from an ingested document."
      },
      "DocumentDetailResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "Document identifier",
            "examples": [
              "doc_123456789"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Title of the document",
            "examples": [
              "Research_Paper_2026.pdf"
            ]
          },
          "file_type": {
            "type": "string",
            "title": "File Type",
            "description": "Type of document (pdf, txt, docx)",
            "examples": [
              "pdf"
            ]
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks",
            "description": "Total count of text chunks",
            "examples": [
              5
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Ingestion processing status",
            "examples": [
              "processed"
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Associated document metadata"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunk"
            },
            "type": "array",
            "title": "Chunks",
            "description": "List of chunks"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Creation timestamp"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "title",
          "file_type",
          "total_chunks",
          "status"
        ],
        "title": "DocumentDetailResponse",
        "description": "Response schema providing details and chunks of a previously ingested document."
      },
      "DocumentUploadRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Title or file name of the document",
            "examples": [
              "Research_Paper_2026.pdf"
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Raw text content or extracted body to be chunked",
            "examples": [
              "Full text of the paper..."
            ]
          },
          "file_type": {
            "type": "string",
            "title": "File Type",
            "description": "Document file extension/type (pdf, docx, txt)",
            "default": "txt",
            "examples": [
              "pdf"
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary metadata such as authors, tags, journal",
            "examples": [
              {
                "authors": [
                  "Nguyen Van A"
                ],
                "year": 2026
              }
            ]
          },
          "chunk_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Size",
            "description": "Override chunk size for splitting",
            "default": 500,
            "examples": [
              500
            ]
          },
          "chunk_overlap": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Overlap",
            "description": "Override chunk overlap for splitting",
            "default": 50,
            "examples": [
              50
            ]
          }
        },
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "DocumentUploadRequest",
        "description": "Request schema for uploading and processing a document."
      },
      "DocumentUploadResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "Generated document ID",
            "examples": [
              "doc_123456789"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Title of the ingested document",
            "examples": [
              "Research_Paper_2026.pdf"
            ]
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks",
            "description": "Number of chunks generated",
            "examples": [
              5
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current ingestion status",
            "default": "processed",
            "examples": [
              "processed"
            ]
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunk"
            },
            "type": "array",
            "title": "Chunks",
            "description": "List of generated chunks"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when ingested"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "title",
          "total_chunks"
        ],
        "title": "DocumentUploadResponse",
        "description": "Response schema returned after a document has been accepted and chunked."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "example": "ingestion-service"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy",
            "example": "healthy"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0",
            "example": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "service"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}