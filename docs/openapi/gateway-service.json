{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway Service - Rag_System_AI",
    "description": "API Gateway microservice exposing public endpoints and orchestrating end-to-end RAG workflows.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Returns the operational status of the API Gateway Service.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": [
          "Chat & Gateway Orchestration"
        ],
        "summary": "Chat with RAG pipeline",
        "description": "Public entry point for clients. Orchestrates vector retrieval, passage reranking, context assembly, and LLM answer generation.",
        "operationId": "chat_pipeline_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "RAG chat answer generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query prompt"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatContextSource": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Chunk identifier",
            "examples": [
              "chk_trend_001"
            ]
          },
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "Parent document identifier",
            "examples": [
              "doc_scientometrics_2026"
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Excerpt content from chunk",
            "examples": [
              "Publication trends analysis..."
            ]
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Relevance similarity score",
            "examples": [
              0.92
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Metadata associated with the source chunk"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "content",
          "score"
        ],
        "title": "ChatContextSource",
        "description": "Schema representing an excerpt of context retrieved and used in the answer."
      },
      "ChatExecutionTiming": {
        "properties": {
          "retrieval_ms": {
            "type": "number",
            "title": "Retrieval Ms",
            "description": "Duration of vector search and reranking in ms",
            "examples": [
              14.5
            ]
          },
          "generation_ms": {
            "type": "number",
            "title": "Generation Ms",
            "description": "Duration of LLM response generation in ms",
            "examples": [
              320.4
            ]
          },
          "total_ms": {
            "type": "number",
            "title": "Total Ms",
            "description": "Total end-to-end processing time in ms",
            "examples": [
              334.9
            ]
          }
        },
        "type": "object",
        "required": [
          "retrieval_ms",
          "generation_ms",
          "total_ms"
        ],
        "title": "ChatExecutionTiming",
        "description": "Latency metrics for individual pipeline steps."
      },
      "ChatRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "User question or search prompt",
            "examples": [
              "What are the latest publication trends in AI scientific literature?"
            ]
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K",
            "description": "Number of context passages to retrieve",
            "default": 5,
            "examples": [
              5
            ]
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Optional LLM model override",
            "examples": [
              "gpt-4o-mini"
            ]
          },
          "include_contexts": {
            "type": "boolean",
            "title": "Include Contexts",
            "description": "Whether to include retrieved context excerpts in response",
            "default": true,
            "examples": [
              true
            ]
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature",
            "description": "LLM sampling temperature",
            "default": 0.7,
            "examples": [
              0.7
            ]
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatRequest",
        "description": "Client request schema for chatting with the RAG pipeline."
      },
      "ChatResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Original user prompt",
            "examples": [
              "What are the latest publication trends in AI scientific literature?"
            ]
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Final synthesized and grounded answer",
            "examples": [
              "Based on recent scientific publications..."
            ]
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model leveraged to generate the answer",
            "examples": [
              "gpt-4o-mini"
            ]
          },
          "contexts": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatContextSource"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contexts",
            "description": "List of source context chunks if requested"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations",
            "description": "Unique source citations referenced in the answer"
          },
          "timing": {
            "$ref": "#/components/schemas/ChatExecutionTiming",
            "description": "Execution timing breakdown"
          }
        },
        "type": "object",
        "required": [
          "query",
          "answer",
          "model",
          "timing"
        ],
        "title": "ChatResponse",
        "description": "Final unified response returned to the client by the API Gateway."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "examples": [
              "gateway-service"
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy",
            "examples": [
              "healthy"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0",
            "examples": [
              "0.1.0"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "service"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}