{
  "openapi": "3.1.0",
  "info": {
    "title": "Retrieval Service - Rag_System_AI",
    "description": "Microservice for vector semantic search, knowledge base lookup, and cross-encoder reranking.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Returns the operational status of the Retrieval Service.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/retrieve": {
      "post": {
        "tags": [
          "Retrieval"
        ],
        "summary": "Retrieve relevant context passages",
        "description": "Queries the vector database for text passages semantically related to the query and applies optional reranking.",
        "operationId": "retrieve_contexts_api_v1_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrievalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Relevant context passages retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or parameters"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "example": "retrieval-service"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy",
            "example": "healthy"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0",
            "example": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "service"
        ],
        "title": "HealthResponse"
      },
      "RetrievalFilter": {
        "properties": {
          "document_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Ids",
            "description": "Restrict search to specific document IDs",
            "examples": [
              [
                "doc_123456789"
              ]
            ]
          },
          "categories": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categories",
            "description": "Filter by document subject domain/category",
            "examples": [
              [
                "AI",
                "Computer Science"
              ]
            ]
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Custom metadata filter key-values"
          }
        },
        "type": "object",
        "title": "RetrievalFilter",
        "description": "Optional metadata filters for vector retrieval."
      },
      "RetrievalRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "User search query or question to retrieve context for",
            "examples": [
              "What are the recent trends in transformer models for scientific literature?"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Number of top matching context chunks to return",
            "default": 5,
            "examples": [
              5
            ]
          },
          "score_threshold": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Threshold",
            "description": "Minimum similarity score threshold",
            "default": 0.5,
            "examples": [
              0.5
            ]
          },
          "rerank": {
            "type": "boolean",
            "title": "Rerank",
            "description": "Whether to apply cross-encoder reranking to initial results",
            "default": true,
            "examples": [
              true
            ]
          },
          "filter": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RetrievalFilter"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional metadata filter parameters"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RetrievalRequest",
        "description": "Request schema for querying top-k relevant contexts."
      },
      "RetrievalResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Original input query",
            "examples": [
              "What are the recent trends in transformer models for scientific literature?"
            ]
          },
          "total_found": {
            "type": "integer",
            "title": "Total Found",
            "description": "Number of results matching the threshold",
            "examples": [
              2
            ]
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievedChunk"
            },
            "type": "array",
            "title": "Results",
            "description": "Ranked list of context chunks"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "description": "Retrieval and reranking latency in milliseconds",
            "examples": [
              14.5
            ]
          }
        },
        "type": "object",
        "required": [
          "query",
          "total_found",
          "latency_ms"
        ],
        "title": "RetrievalResponse",
        "description": "Response schema containing ranked context passages."
      },
      "RetrievedChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Unique chunk ID",
            "examples": [
              "chk_987654321"
            ]
          },
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "Source document ID",
            "examples": [
              "doc_123456789"
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Retrieved passage text",
            "examples": [
              "Recent studies highlight exponential growth in generative AI publications."
            ]
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Vector similarity score (cosine/dot product)",
            "examples": [
              0.895
            ]
          },
          "rerank_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rerank Score",
            "description": "Refined cross-encoder reranking score",
            "examples": [
              0.942
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Associated chunk and document metadata"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "content",
          "score"
        ],
        "title": "RetrievedChunk",
        "description": "Schema representing a retrieved context passage with similarity score."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}