{
  "openapi": "3.1.0",
  "info": {
    "title": "Embedding Service - Rag_System_AI",
    "description": "Microservice for converting text chunks and queries into dense vector representations.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Returns the operational status of the Embedding Service.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/embeddings": {
      "post": {
        "tags": [
          "Embeddings"
        ],
        "summary": "Generate vector embeddings",
        "description": "Transforms an array of text chunks or queries into dense float embedding vectors.",
        "operationId": "create_embeddings_api_v1_embeddings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Embeddings successfully generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Empty or invalid input texts"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmbeddingRequest": {
        "properties": {
          "texts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Texts",
            "description": "List of text strings or chunk passages to be converted into vector embeddings",
            "examples": [
              [
                "Scientific publication trends in machine learning",
                "RAG architecture with FastAPI microservices"
              ]
            ]
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Optional embedding model override (e.g. text-embedding-3-small, BAAI/bge-m3)",
            "examples": [
              "text-embedding-3-small"
            ]
          }
        },
        "type": "object",
        "required": [
          "texts"
        ],
        "title": "EmbeddingRequest",
        "description": "Request schema for generating vector embeddings."
      },
      "EmbeddingResponse": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Name of the model used to compute embeddings",
            "examples": [
              "text-embedding-3-small"
            ]
          },
          "dimension": {
            "type": "integer",
            "title": "Dimension",
            "description": "Vector dimensionality",
            "examples": [
              1536
            ]
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/EmbeddingVectorItem"
            },
            "type": "array",
            "title": "Data",
            "description": "Array of embedding vectors"
          },
          "usage": {
            "$ref": "#/components/schemas/EmbeddingUsage",
            "description": "Token usage details"
          }
        },
        "type": "object",
        "required": [
          "model",
          "dimension",
          "data",
          "usage"
        ],
        "title": "EmbeddingResponse",
        "description": "Response schema returned after embedding generation."
      },
      "EmbeddingUsage": {
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "description": "Estimated token count of the input",
            "examples": [
              24
            ]
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens",
            "description": "Total tokens processed",
            "examples": [
              24
            ]
          }
        },
        "type": "object",
        "required": [
          "prompt_tokens",
          "total_tokens"
        ],
        "title": "EmbeddingUsage",
        "description": "Token usage metrics for embedding generation."
      },
      "EmbeddingVectorItem": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index",
            "description": "Position index of the corresponding input text",
            "examples": [
              0
            ]
          },
          "vector": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Vector",
            "description": "High-dimensional floating point embedding vector"
          },
          "dimension": {
            "type": "integer",
            "title": "Dimension",
            "description": "Dimensionality of the vector",
            "examples": [
              1536
            ]
          }
        },
        "type": "object",
        "required": [
          "index",
          "vector",
          "dimension"
        ],
        "title": "EmbeddingVectorItem",
        "description": "Schema representing an individual vector output."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "example": "embedding-service"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy",
            "example": "healthy"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0",
            "example": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "service"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}