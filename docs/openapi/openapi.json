          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": [
          "End-to-End RAG Pipeline"
        ],
        "summary": "Chat with RAG pipeline",
        "description": "Unified entry point. Coordinates retrieval, hybrid search, reranking, context assembly, and LLM generation in-process.",
        "operationId": "chat_pipeline_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RagPipelineRequest"
