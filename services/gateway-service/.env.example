# Gateway Service Configuration
SERVICE_NAME=gateway-service
APP_ENV=development
DEBUG=true
PORT=8005
HOST=0.0.0.0
LOG_LEVEL=INFO

# Downstream Microservices URLs
INGESTION_SERVICE_URL=http://ingestion-service:8001
