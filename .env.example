# Rag_System_AI Modular Monolith Configuration
PROJECT_NAME="Rag_System_AI"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Phase 1: Ingestion Config
UPLOAD_DIR="./uploads"
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Phase 2: Indexing & Vector DB
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
VECTOR_DB_TYPE="qdrant"
VECTOR_DB_HOST="localhost"
VECTOR_DB_PORT=6333

# Phase 3: Retrieval Config
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.5
ENABLE_RERANKING=true

# Phase 4: Generation Config
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
OPENAI_API_KEY=""
