# Rag_System_AI Modular Monolith Configuration
PROJECT_NAME="Rag_System_AI"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Phase 1: Ingestion Config
UPLOAD_DIR="./uploads"
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Phase 2: Indexing (Postgres/PgVector & Neo4j Graph DB)
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
VECTOR_DB_TYPE="pgvector"

# PostgreSQL / pgvector (managed via pgAdmin)
POSTGRES_HOST=100.121.61.95
POSTGRES_PORT=5432
POSTGRES_DB=researchpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_SCHEMA=public

# Neo4j Graph Database (Knowledge Graph)
NEO4J_URI=bolt://100.121.61.95:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_DATABASE=neo4j

# Phase 3: Retrieval Config
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.5
ENABLE_RERANKING=true

# Phase 4: Generation Config
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
OPENAI_API_KEY=""
